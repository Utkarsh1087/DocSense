# ─── AI Models ─────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Vector Database (Pinecone) ────────────────────────────────────────────────
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=your_index_name_here
# Free tier: 100K vectors, 768 dimensions, cosine similarity

# ─── Database (MongoDB Atlas) ──────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/docsense?appName=myapp
# Free tier: M0 cluster, 512MB storage

# ─── Stripe Billing ────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
# Get STRIPE_WEBHOOK_SECRET from: Stripe Dashboard → Webhooks → Add endpoint
# Endpoint URL: https://yourdomain.com/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# ─── Auth (JWT) ────────────────────────────────────────────────────────────────
# Generate a strong secret: openssl rand -base64 64
JWT_SECRET=your_strong_random_secret_at_least_32_chars_here

# ─── App Config ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# In production, set to your actual domain: https://docsense.yourdomain.com

# ─── Admin (Optional) ──────────────────────────────────────────────────────────
# Comma-separated list of user IDs that can access /api/analytics/admin
ADMIN_USER_IDS=usr_your_admin_user_id_here
